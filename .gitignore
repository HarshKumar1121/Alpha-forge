# BRAIN Credentials and Local Settings.
.env

# References for Development
# CLAUDE.md is tracked on purpose: it carries the hard rules and the upstream policy, which
# have to travel with the repo. Upstream alpha-harness ships no CLAUDE.md, so it cannot conflict.
# forge: /docs/* instead of upstream's /docs/ so docs/forge/ (Forge design + playbooks) is tracked.
/docs/*
!/docs/forge/

.venv/
node_modules/
dist/
# The built frontend, served by the backend (`lefthook run build`).
backend/src/alpha_harness/web/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.tsbuildinfo

# Desktop app (Tauri): build output, generated schemas, and the uv each build bundles.
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/src-tauri/binaries/

# Alpha Forge
reference/
.env
*.db
*.db-wal
*.db-shm
cookies.json
catalog_*.json
